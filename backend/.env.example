NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stockflow_app
DB_PASSWORD=CAMBIAR_PASSWORD
DB_NAME=stockflow
JWT_ACCESS_SECRET=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTROS_64_CARACTERES_ALEATORIOS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Correo real. No se imprimen códigos en logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StockFlow <noreply@example.com>
# Dominio HTTPS del backend para callbacks OAuth
PUBLIC_API_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# MySQL remoto: valida certificado; CA opcional si ya es de confianza del sistema.
DB_SSL=false
DB_SSL_CA_FILE=

# Origen exacto del frontend web para el retorno OAuth
WEB_APP_URL=http://localhost:8081

# Proveedor HTTPS compatible con Nominatim search; vacío desactiva geocodificación.
GEOCODING_URL=
GEOCODING_API_KEY=
# Encargado activo para auditar entradas del seed
SEED_USER_ID=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
